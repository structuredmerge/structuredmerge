  class AlternativeState
    type value = :present | :absent | :invalid | :opaque
  end

  class AttachmentHint
    type value = :leading | :inline | :trailing | :preamble | :postlude | :orphan | :unknown
  end

  class ConflictAlternativeState
    type value = :present | :absent
  end

  class ConflictCategory
    type value = :content | :delete_modify | :add_add | :move | :rename | :order | :identity | :ownership | :syntax | :binary_overlap | :archive_entry | :provider_specific
  end

  class ConflictRecord
    def self.from_canonical: (PortableConflict value) -> ConflictRecord
    def canonical: () -> PortableConflict?
    def self.from_migration: (ResultConflict value) -> ConflictRecord
    def migration: () -> ResultConflict?
  end

  class CrisprLimitOperator
    type value = :equal | :not_equal | :at_most | :at_least | :less_than | :greater_than
  end

  class DiagnosticCategory
    type value = :parse_error | :destination_parse_error | :unsupported_feature | :fallback_applied | :ambiguity | :merge_conflict | :kind_mismatch | :unsupported_version | :assumed_default | :configuration_error | :replay_rejected
  end

  class DiagnosticLayer
    type value = :transport | :registry | :parser | :analysis | :provider | :renderer | :verifier | :adapter | :runner
  end

  class DiagnosticRecord
    def self.from_canonical: (PortableDiagnostic value) -> DiagnosticRecord
    def canonical: () -> PortableDiagnostic?
    def self.from_migration: (ResultDiagnostic value) -> DiagnosticRecord
    def migration: () -> ResultDiagnostic?
  end

  class DiagnosticSeverity
    type value = :info | :warning | :error
  end

  class DirectorySessionMode
    type value = :plan | :apply | :reapply
  end

  class LocalizationStatus
    type value = :exact | :owner | :coarse | :whole_document | :unavailable
  end

  class NodeRole
    type value = :structural | :token | :trivia | :comment | :delimiter | :separator | :virtual | :error | :opaque
  end

  class OperationKind
    type value = :analyze | :diff2 | :merge2 | :merge3
  end

  class OperationPolicy
    def self.from_analyze: (AnalyzePolicy value) -> OperationPolicy
    def analyze: () -> AnalyzePolicy?
    def self.from_diff2: (DiffPolicy value) -> OperationPolicy
    def diff2: () -> DiffPolicy?
    def self.from_merge2: (DirectionalMergePolicy value) -> OperationPolicy
    def merge2: () -> DirectionalMergePolicy?
    def self.from_merge3: (ThreeWayMergePolicy value) -> OperationPolicy
    def merge3: () -> ThreeWayMergePolicy?
  end

  class OwnerChangeKind
    type value = :added | :deleted | :edited
  end

  class ParseSeverity
    type value = :info | :warning | :error
  end

  class PolicySurface
    type value = :fallback | :array
  end

  class PortableCategory
    type value = :parse_error | :destination_parse_error | :invalid_request | :configuration_error | :selection_error | :backend_unavailable | :unsupported_feature | :ambiguity | :analysis_error | :merge_conflict | :render_error | :preservation_error | :verification_error | :fallback_applied | :assumed_default | :cancelled | :deadline_exceeded | :resource_limit | :replay_rejected | :internal_error
  end

  class ResolutionStatus
    type value = :unresolved | :resolved
  end

  class ResolutionStrategy
    type value = :none | :select_role | :combine | :policy | :custom
  end

  class ReviewDecisionAction
    type value = :accept_default_context | :provide_explicit_context | :apply_delegated_child_group
  end

  class ReviewDiagnosticReason
    type value = :missing_required_payload | :family_mismatch | :request_not_found
  end

  class SourceEncoding
    type value = :utf8 | :binary
  end

  class SourceRevision
    type value = :base | :ours | :theirs
  end

  class SourceRole
    type value = :source | :before | :after | :incoming | :current | :base | :ours | :theirs | :output
  end

  class TemplateDirectoryPlanStatus
    type value = :create | :update | :keep | :blocked | :omitted
  end

  class TemplateExecutionAction
    type value = :blocked | :omit | :keep | :raw_copy | :write_prepared_content | :merge_prepared_content
  end

  class TemplateStrategy
    type value = :merge | :accept_template | :keep_destination | :raw_copy
  end

  class TemplateTreeRunStatus
    type value = :created | :updated | :kept | :blocked | :omitted
  end

  class ThreeWayMergeOutcome
    type value = :clean | :conflict | :error
  end

  def self.apply_explicit_source_edits: (SourceEditRequest request, SourceEditLimits limits) -> SourceEditResult

  def self.create_operation_control: () -> OperationControl

  def self.diff_native_owners: (NativeDiffRequest request, ParseLimits limits) -> NativeDiffResult

  def self.diff_native_owners_controlled: (NativeDiffRequest request, ParseLimits limits, OperationControl control) -> NativeDiffResult

  def self.execute_operation: (OperationRequest request, ParseLimits limits) -> OperationResult

  def self.execute_operation_controlled: (OperationRequest request, ParseLimits limits, OperationControl control) -> OperationResult

  def self.merge_python_declarations: (Array[ParseRequest] requests, ParseLimits limits) -> NativeMergeResult

  def self.merge_python_declarations_controlled: (Array[ParseRequest] requests, ParseLimits limits, OperationControl control) -> NativeMergeResult

  def self.merge_yaml_mapping: (Array[ParseRequest] requests, ParseLimits limits) -> NativeMergeResult

  def self.merge_yaml_mapping_controlled: (Array[ParseRequest] requests, ParseLimits limits, OperationControl control) -> NativeMergeResult

  def self.native_merge_profiles: () -> Array[NativeMergeProfile]

  def self.parse_sources: (Array[ParseRequest] requests, ParseLimits limits) -> Array[CoreParseResult]

  def self.parse_sources_controlled: (Array[ParseRequest] requests, ParseLimits limits, OperationControl control) -> Array[CoreParseResult]

  def self.parser_registry_inventory: () -> ParserRegistryInventory

  def self.parser_selection_report: (ParserSelectionRequest request, ParseLimits limits) -> SelectionReport

  def self.parser_selection_report_controlled: (ParserSelectionRequest request, ParseLimits limits, OperationControl control) -> SelectionReport

  def self.plan_template_directory: (TemplateSessionOptions options) -> TemplateSessionPlanReport

  def self.register_language_pack_parser: (String id, String language) -> ParserProviderDescriptor

  def self.register_parser_host: (_ParserHost host) -> void

  def self.report_structural_boundary: () -> CrisprBoundaryReport

  def self.report_structural_destination: (CrisprDestinationRequest request) -> CrisprDestinationReport

  def self.report_structural_limit: (CrisprLimitRequest request) -> CrisprLimitReport

  def self.report_structural_match: (CrisprMatchRequest request) -> CrisprMatchReport

  def self.report_structural_operations: (Array[CrisprOperationRequest] requests) -> CrisprBatchOperationReport

  def self.report_structural_selection: (CrisprSelectionRequest request) -> CrisprSelectionReport

  def self.report_template_options: (TemplateSessionOptions options) -> TemplateSessionRequestReport

  def self.report_template_profile: (TemplateProfileRequest request) -> TemplateSessionRequestReport

  def self.unregister_parser_host: (String id) -> void

  def self.unregister_parser_provider: (String id) -> void

  interface _ParserHost
    def descriptor: () -> ParserProviderDescriptor
    def probe_batch: (ProbeBatchRequest request) -> ProbeBatchResult
    def parse_batch: (ParseBatchRequest request) -> ParseBatchResult
  end

end
