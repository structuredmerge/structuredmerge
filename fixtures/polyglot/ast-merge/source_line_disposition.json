    {
      "name": "a blank gap before a leading comment remains controlled by the preceding owner",
      "source": "alpha()\n\n\n# beta docs\nbeta()\n",
      "style": "hash_comment",
      "owners": [
        {
          "id": "alpha",
          "start_line": 1,
          "end_line": 1,
          "indent": 0
        },
        {
          "id": "beta",
          "start_line": 5,
          "end_line": 5,
          "indent": 0
        }
      ],
      "comments": [
        {
          "line": 4,
          "text": "# beta docs",
          "normalized_content": "beta docs",
          "full_line": true,
          "indent": 0
        }
      ],
      "comment_regions": [
        {
          "id": "comment-region:leading:4-4",
          "selection_key": "comment:beta:leading",
          "owner_id": "beta",
          "kind": "leading",
          "start_line": 4,
          "end_line": 4
        }
      ],
      "layout_gaps": [
        {
          "id": "layout-gap:2-3",
          "selection_key": "gap:interstitial:alpha:beta",
          "kind": "interstitial",
          "start_line": 2,
          "end_line": 3,
          "before_owner_id": "alpha",
          "after_owner_id": "beta",
          "controller_side": "before",
          "controller_owner_id": "alpha"
        }
      ],
      "expected": [
        {
          "line_number": 1,
          "line": "alpha()\n",
          "kind": "structural_owner",
          "selection_key": "owner:alpha",
          "owner_id": "alpha",
          "comment_region_ids": [],
          "comment_kind": null,
          "gap_id": null,
          "controller_owner_id": null,
          "root_region_kind": null
        },
        {
          "line_number": 2,
          "line": "\n",
          "kind": "layout_gap",
          "selection_key": "gap:interstitial:alpha:beta",
          "owner_id": null,
          "comment_region_ids": [],
          "comment_kind": null,
          "gap_id": "layout-gap:2-3",
          "controller_owner_id": "alpha",
          "before_owner_id": "alpha",
          "after_owner_id": "beta",
          "root_region_kind": null
        },
        {
          "line_number": 3,
          "line": "\n",
          "kind": "layout_gap",
          "selection_key": "gap:interstitial:alpha:beta",
          "owner_id": null,
          "comment_region_ids": [],
          "comment_kind": null,
          "gap_id": "layout-gap:2-3",
          "controller_owner_id": "alpha",
          "before_owner_id": "alpha",
          "after_owner_id": "beta",
          "root_region_kind": null
        },
        {
          "line_number": 4,
          "line": "# beta docs\n",
          "kind": "comment_owner",
          "selection_key": "comment:beta:leading",
          "owner_id": "beta",
          "comment_region_ids": [
            "comment-region:leading:4-4"
          ],
          "comment_kind": "leading",
          "gap_id": null,
          "controller_owner_id": null,
          "root_region_kind": null
        },
        {
          "line_number": 5,
          "line": "beta()\n",
          "kind": "structural_owner",
          "selection_key": "owner:beta",
          "owner_id": "beta",
          "comment_region_ids": [],
          "comment_kind": null,
          "gap_id": null,
          "controller_owner_id": null,
          "root_region_kind": null
        }
      ]
    },
