          "owner_id": "alpha",
          "comment_region_ids": [],
          "comment_kind": null,
          "gap_id": null,
          "controller_owner_id": null,
          "root_region_kind": null,
          "selection_key": "owner:alpha"
        },
        {
          "line_number": 2,
          "line": "unknown syntax\n",
          "kind": "unmanaged",
          "owner_id": null,
          "comment_region_ids": [],
          "comment_kind": null,
          "gap_id": null,
          "controller_owner_id": null,
          "root_region_kind": null,
          "selection_key": "unmanaged:2"
        }
      ]
    },
