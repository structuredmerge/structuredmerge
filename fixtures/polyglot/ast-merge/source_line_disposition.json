        {
          "line_number": 2,
          "line": "\n",
          "kind": "unmanaged",
          "owner_id": null,
          "comment_region_ids": [],
          "comment_kind": null,
          "gap_id": null,
          "controller_owner_id": null,
          "root_region_kind": null,
          "selection_key": "unmanaged:2"
        },
        {
          "line_number": 3,
          "line": "unknown syntax\n",
          "kind": "unmanaged",
          "owner_id": null,
          "comment_region_ids": [],
          "comment_kind": null,
          "gap_id": null,
