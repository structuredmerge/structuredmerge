{
  "id": "rust_syn_parse_diagnostic_span",
  "contract": "rust_syn_parse_diagnostic_span",
  "description": "Native syn syntax diagnostics carry the exact source span of the offending token.",
  "input": {
    "source": "// λ\nfn broken() { let value = ; }\n"
