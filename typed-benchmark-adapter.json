{
  "schema_version": "structuredmerge.benchmark.adapter-descriptor/v1",
  "adapter": {
    "adapter_id": "typed-core.python.language-pack",
    "implementation": "rust-via-python",
    "package": "structuredmerge-core",
    "package_version": "0.2.0",
    "source": {"repository": "structuredmerge/structuredmerge"}
  },
  "source_root": ".",
  "provider": {
    "merge_providers": {
      "json": {
      "provider_id": "kernel.json / kernel.git.json",
      "package": "structuredmerge-core",
      "profile": "kernel.json.nested.v1 (merge2); kernel.git.json.v1 (merge3)"
      },
      "bash": {"provider_id": "kernel.bash", "package": "structuredmerge-core", "profile": "kernel.bash.owners.v1"},
      "go": {"provider_id": "kernel.go", "package": "structuredmerge-core", "profile": "kernel.go.owners.v1"},
      "rust": {"provider_id": "kernel.rust", "package": "structuredmerge-core", "profile": "kernel.rust.owners.v1"},
      "typescript": {"provider_id": "kernel.typescript", "package": "structuredmerge-core", "profile": "kernel.typescript.owners.v1"}
    },
    "parser_provider": {
      "provider_id": "tree-sitter-language-pack",
      "backend_family": "tree-sitter",
      "selection_mode": "explicit",
      "boundary": "installed Python binding / TreeHaver"
    }
  },
  "supports": {
    "operations": ["merge2", "merge3"],
    "families": ["bash", "go", "json", "rust", "typescript"],
    "dialects": ["bash", "go", "json", "jsonc", "json5", "rust", "typescript", "tsx"],
    "combinations": [
      {"family": "json", "operations": ["merge2", "merge3"], "dialects": ["json", "jsonc", "json5"]},
      {"family": "bash", "operations": ["merge3"], "dialects": ["bash"]},
      {"family": "go", "operations": ["merge3"], "dialects": ["go"]},
      {"family": "rust", "operations": ["merge3"], "dialects": ["rust"]},
      {"family": "typescript", "operations": ["merge3"], "dialects": ["typescript", "tsx"]}
    ]
  },
  "environment": {"binding_runtime": "python", "semantic_runtime": "rust", "publication_gate": false}
}
