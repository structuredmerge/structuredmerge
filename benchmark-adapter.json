{
  "schema_version": "structuredmerge.benchmark.adapter-descriptor/v1",
  "adapter": {
    "adapter_id": "rust-candidate.smorg-rs",
    "implementation": "rust",
    "package": "smorg-rs",
    "package_version": "0.2.0",
    "source": {
      "repository": "structuredmerge/structuredmerge-rust"
    }
  },
  "source_root": ".",
  "provider": {
    "merge_providers": {
      "json": {
        "provider_id": "rust.json",
        "package": "json-merge",
        "profile": "source_preserving"
      },
      "toml": {
        "provider_id": "rust.toml",
        "package": "toml-merge",
        "profile": "source_preserving"
      },
      "yaml": {
        "provider_id": "rust.yaml",
        "package": "yaml-merge",
        "profile": "source_preserving"
      }
    },
    "parser_provider": {
      "provider_id": "tree-sitter-language-pack",
      "backend_family": "tree-sitter",
      "selection_mode": "explicit",
      "boundary": "tree-haver"
    }
  },
  "supports": {
    "operations": ["merge2", "merge3", "metamorphic"],
    "families": ["json", "toml", "yaml"],
    "dialects": ["json", "jsonc", "json5", "toml", "yaml"],
    "combinations": [
      {
        "family": "json",
        "operations": ["merge2", "merge3", "metamorphic"],
        "dialects": ["json", "jsonc", "json5"]
      },
      {
        "family": "toml",
        "operations": ["merge2"],
        "dialects": ["toml"]
      },
      {
        "family": "yaml",
        "operations": ["merge2"],
        "dialects": ["yaml"]
      }
    ]
  },
  "environment": {
    "runtime": "rust",
    "edition": "2024"
  }
}
