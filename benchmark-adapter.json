{
  "schema_version": "structuredmerge.benchmark.adapter-descriptor/v1",
  "adapter": {
    "adapter_id": "rust-candidate.smorg-rs",
    "implementation": "rust",
    "package": "smorg-rs",
    "package_version": "0.2.0",
    "source": {
      "repository": "structuredmerge/structuredmerge-rust"
    }
  },
  "source_root": ".",
  "provider": {
    "merge_providers": {
      "bash": {
        "provider_id": "rust.bash",
        "package": "bash-merge",
        "profile": "source_preserving"
      },
      "go": {
        "provider_id": "rust.go",
        "package": "go-merge",
        "profile": "source_preserving"
      },
      "json": {
        "provider_id": "rust.json",
        "package": "json-merge",
        "profile": "source_preserving"
      },
      "markdown": {
        "provider_id": "rust.markdown",
        "package": "markdown-merge",
        "profile": "source_preserving"
      },
      "python": {
        "provider_id": "rust.generic.tslp",
        "package": "generic-merge",
        "profile": "experimental_named_top_level"
      },
      "ruby": {
        "provider_id": "rust.ruby",
        "package": "ruby-merge",
        "profile": "source_preserving"
      },
      "rust": {
        "provider_id": "rust.rust",
        "package": "rust-merge",
        "profile": "source_preserving"
      },
      "rbs": {
        "provider_id": "rust.rbs",
        "package": "rbs-merge",
        "profile": "source_preserving"
      },
      "toml": {
        "provider_id": "rust.toml",
        "package": "toml-merge",
        "profile": "source_preserving"
      },
      "typescript": {
        "provider_id": "rust.typescript",
        "package": "typescript-merge",
        "profile": "source_preserving"
      },
      "yaml": {
        "provider_id": "rust.yaml",
        "package": "yaml-merge",
        "profile": "source_preserving"
      }
    },
    "parser_provider": {
      "provider_id": "tree-sitter-language-pack",
      "backend_family": "tree-sitter",
      "selection_mode": "explicit",
      "boundary": "tree-haver"
    }
  },
  "supports": {
    "operations": ["merge2", "merge3", "metamorphic"],
    "families": ["bash", "go", "json", "markdown", "python", "rbs", "ruby", "rust", "toml", "typescript", "yaml"],
    "dialects": ["bash", "go", "json", "jsonc", "json5", "markdown", "python", "rbs", "ruby", "rust", "toml", "typescript", "tsx", "yaml"],
    "combinations": [
      {
        "family": "bash",
        "operations": ["merge3"],
        "dialects": ["bash"]
      },
      {
        "family": "go",
        "operations": ["merge3"],
        "dialects": ["go"]
      },
      {
        "family": "json",
        "operations": ["merge2", "merge3", "metamorphic"],
        "dialects": ["json", "jsonc", "json5"]
      },
      {
        "family": "markdown",
        "operations": ["merge2"],
        "dialects": ["markdown"]
      },
      {
        "family": "python",
        "operations": ["merge3"],
        "dialects": ["python"]
      },
      {
        "family": "rbs",
        "operations": ["merge2"],
        "dialects": ["rbs"]
      },
      {
        "family": "ruby",
        "operations": ["merge2"],
        "dialects": ["ruby"]
      },
      {
        "family": "rust",
        "operations": ["merge3"],
        "dialects": ["rust"]
      },
      {
        "family": "toml",
        "operations": ["merge2"],
        "dialects": ["toml"]
      },
      {
        "family": "typescript",
        "operations": ["merge3"],
        "dialects": ["typescript", "tsx"]
      },
      {
        "family": "yaml",
        "operations": ["merge2"],
        "dialects": ["yaml"]
      }
    ]
  },
  "environment": {
    "runtime": "rust",
    "edition": "2024"
  }
}
